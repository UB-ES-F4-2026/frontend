{
  "name": "fintech-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/**/*.integration.test.tsx",
    "test:unit:coverage": "vitest run --coverage --exclude tests/**/*.integration.test.tsx",
    "test:integration": "vitest run tests/*.integration.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "4.1.12",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "8.3.3",
    "vitest": "^4.1.12"
  }
}
